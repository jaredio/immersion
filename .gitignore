# Installed dependencies and local caches
node_modules/
__pycache__/
*.py[cod]
.cache/
.pytest_cache/

# Generated diagnostics, browser profiles, and research downloads
/tmp/
/research/
/artifacts/
/test-results/
/playwright-report/
/coverage/
/.nyc_output/

# Keep only the supported browser builds and release packages in dist
/dist/*
!/dist/chrome/
!/dist/firefox/
!/dist/immersion-chrome.zip
!/dist/immersion-firefox.zip

# Local secrets
.env
.env.*
!.env.example

# Logs, temporary files, and editor backups
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Operating system metadata
.DS_Store
Thumbs.db
Desktop.ini
