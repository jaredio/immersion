{
  "manifest_version": 3,
  "name": "Immersion",
  "version": "0.10.0",
  "description": "A sleek dark experience for Kick, with inline multistream, adjustable layouts, quick chat tabs and leaner chat scrolling.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.fxtwitter.com/*",
    "https://www.tiktok.com/*",
    "https://vt.tiktok.com/*",
    "https://vm.tiktok.com/*",
    "https://www.youtube.com/oembed*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Immersion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://kick.com/*",
        "https://www.kick.com/*"
      ],
      "js": [
        "scroll.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://kick.com/*",
        "https://www.kick.com/*"
      ],
      "css": [
        "theme.css",
        "polish.css"
      ],
      "js": [
        "shared.js",
        "ui.js",
        "profile.js",
        "support-data.js",
        "support.js",
        "multiview.js",
        "chat-clips.js",
        "clip-bridge.js",
        "x-post-data.js",
        "x-posts.js",
        "media-data.js",
        "media-embeds.js",
        "reply-preview.js",
        "notices.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://powerchat.live/*",
        "https://www.powerchat.live/*",
        "https://kickbot.com/tips/*",
        "https://www.kickbot.com/tips/*",
        "https://streamelements.com/*/tip*",
        "https://www.streamelements.com/*/tip*"
      ],
      "css": [
        "support-form.css"
      ],
      "js": [
        "support-data.js",
        "support-frame.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://kick.com/popout/*/chat",
        "https://www.kick.com/popout/*/chat"
      ],
      "css": [
        "theme.css",
        "polish.css"
      ],
      "js": [
        "shared.js",
        "chat-clips.js",
        "clip-bridge.js",
        "x-post-data.js",
        "x-posts.js",
        "media-data.js",
        "media-embeds.js",
        "reply-preview.js",
        "chat-frame.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://player.kick.com/*"
      ],
      "js": [
        "player-frame.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui.css",
        "vendor/hls.light.mjs"
      ],
      "matches": [
        "https://kick.com/*",
        "https://www.kick.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "background": {
    "service_worker": "x-background.js"
  },
  "minimum_chrome_version": "120"
}
