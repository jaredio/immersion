{
  "manifest_version": 2,
  "name": "Immersion",
  "version": "0.10.0",
  "description": "A sleek dark experience for Kick, with inline multistream, adjustable layouts, quick chat tabs and leaner chat scrolling.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "webRequest",
    "webRequestBlocking",
    "https://api.fxtwitter.com/*",
    "https://www.tiktok.com/*",
    "https://vt.tiktok.com/*",
    "https://vm.tiktok.com/*",
    "https://www.youtube.com/oembed*",
    "https://kick.com/*",
    "https://www.kick.com/*",
    "https://clips.kick.com/*",
    "https://stream.kick.com/*",
    "https://kickbot.com/*",
    "https://www.kickbot.com/*",
    "https://streamelements.com/*",
    "https://www.streamelements.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "kick-telemetry",
        "enabled": true,
        "path": "telemetry-rules.json"
      }
    ]
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kick.com/*",
        "https://www.kick.com/*"
      ],
      "css": [
        "theme.css",
        "polish.css"
      ],
      "js": [
        "theme-start.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://kick.com/*",
        "https://www.kick.com/*"
      ],
      "js": [
        "scroll.js",
        "native-search-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://kick.com/*",
        "https://www.kick.com/*"
      ],
      "exclude_matches": [
        "https://kick.com/popout/*/chat",
        "https://www.kick.com/popout/*/chat"
      ],
      "js": [
        "stream-clock.js",
        "performance.js",
        "shared.js",
        "dom.js",
        "ui.js",
        "profile.js",
        "support-data.js",
        "support.js",
        "channel-library.js",
        "channel-page.js",
        "channel-panel.js",
        "player-controls.js",
        "multi-layout.js",
        "multi-view.js",
        "multi-metadata.js",
        "multi-session.js",
        "multi-player-bus.js",
        "multi-startup.js",
        "lifetime.js",
        "player-state.js",
        "multi-chat.js",
        "multi-stream-player.js",
        "multi-stream-tile.js",
        "multi-clip-tile.js",
        "multiview.js",
        "chat-clips.js",
        "clip-bridge.js",
        "x-post-data.js",
        "x-posts.js",
        "media-data.js",
        "media-embeds.js",
        "reply-preview.js",
        "notices.js",
        "checkouts.js",
        "search.js",
        "search-window.js",
        "native-search.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://powerchat.live/*",
        "https://www.powerchat.live/*",
        "https://kickbot.com/tips/*",
        "https://www.kickbot.com/tips/*",
        "https://streamelements.com/*/tip*",
        "https://www.streamelements.com/*/tip*"
      ],
      "css": [
        "support-form.css"
      ],
      "js": [
        "support-data.js",
        "support-frame.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://kick.com/popout/*/chat",
        "https://www.kick.com/popout/*/chat"
      ],
      "js": [
        "stream-clock.js",
        "performance.js",
        "shared.js",
        "dom.js",
        "chat-clips.js",
        "clip-bridge.js",
        "x-post-data.js",
        "x-posts.js",
        "media-data.js",
        "media-embeds.js",
        "reply-preview.js",
        "chat-frame.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://kick.com/*",
        "https://www.kick.com/*"
      ],
      "js": [
        "stream-clock.js",
        "performance.js",
        "full-player-frame.js",
        "player-controls.js",
        "player-frame.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://player.kick.com/*"
      ],
      "js": [
        "stream-clock.js",
        "performance.js",
        "player-controls.js",
        "player-frame.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    "ui.css",
    "vendor/hls.light.mjs"
  ],
  "content_security_policy": "script-src 'self'; object-src 'none'",
  "background": {
    "scripts": [
      "privacy-background.js",
      "x-post-data.js",
      "x-background.js",
      "media-data.js",
      "media-background.js",
      "support-data.js",
      "support-background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Immersion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kick-refined@local.extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
